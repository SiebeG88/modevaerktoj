# Mødeværktøj - miljøvariabler
# Kopier til .env og indsæt dine egne nøgler. .env må aldrig committes.

# Anthropic API-nøgle (kræves til referat-generering).
# Få nøgle på https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Gemini API-nøgle (kræves hvis engine=gemini).
# Få nøgle på https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (Valgfrit) Overstyr default-mappe for mødefiler.
# MEETINGS_DIR=/absolut/sti/til/anden/mappe
